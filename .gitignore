# ==============================================================================
# Git Ignore - Next.js & Study Space Project
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependencies
# ------------------------------------------------------------------------------
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ------------------------------------------------------------------------------
# Next.js & Build Outputs
# ------------------------------------------------------------------------------
.next/
out/
build/
dist/
dist-admin/

# StudySpace fixed assets (~479MB) — hosted on R2, kept locally for offline dev only
public/study/

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (NEVER COMMIT SENSITIVE DATA)
# ------------------------------------------------------------------------------
.env
.env.*
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Allow committing example environment file if present
!.env.example
!.env*.example

# Private Keys, Certificates & Keystores
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.pkcs12
*.jks
*.keystore
id_rsa*
id_ed25519*

# Credentials & Tokens
*.secret
*.secrets
secrets/
*.credentials
credentials.json
token.json

# Cloudflare Workers Secrets / Local State
.dev.vars
.dev.vars.*

# Firebase & GCP Service Accounts / Local State
*serviceAccountKey*.json
*firebase-adminsdk*.json
*-adminsdk-*.json
google-services.json
GoogleService-Info.plist
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# Package Manager Auth Tokens (prevents leaking registry credentials)
.npmrc
.yarnrc

# ------------------------------------------------------------------------------
# Logs & Debugging
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Testing & Code Coverage
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
playwright-report/
test-results/

# Bộ media thử admin (ảnh chụp, kết quả, script kiểm local — chỉ để tham khảo)
admin-media-test/

# ------------------------------------------------------------------------------
# Caches & Build Tools
# ------------------------------------------------------------------------------
.cache/
.eslintcache
.turbo/
.swc/
.parcel-cache/
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------------------------------------------
# Databases, Local Dumps & Backups
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
*.dump
*.bak
*.backup
*.old
*.orig
*.rej

# ------------------------------------------------------------------------------
# Archives & Compressed Files
# ------------------------------------------------------------------------------
*.zip
*.tar.gz
*.tgz
*.rar
*.7z

# ------------------------------------------------------------------------------
# Python (AG Kit Scripts & Virtual Environments)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
.pytest_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# IDEs & Text Editors
# ------------------------------------------------------------------------------
.idea/
.vscode/
.cursor/
.zed/
.qoder/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw[po]
*~

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~

# ------------------------------------------------------------------------------
# AI & Tooling Session Caches / Local Overrides
# ------------------------------------------------------------------------------
.agent/
.agents/
.agents
.gemini/
.claude/
.antigravity/
*.local
*.tmp
*.temp

# ------------------------------------------------------------------------------
# Hosting & Deployment
# ------------------------------------------------------------------------------
.vercel

# ------------------------------------------------------------------------------
# Local Admin Studio & Local Backups (Offline Development Only)
# ------------------------------------------------------------------------------
src/app/admin/
src/app/api/
src/data/assets/backups/
bg-asset-studio-plan.md
tools/
*_frames/

# Taste-skill render output
.taste-skill/inspect/
.taste-skill/inspect-live/
