{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zenstudy-admin",
  "main": "./admin-worker/_worker.ts",
  "compatibility_date": "2026-10-24",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  // keep_vars chỉ giữ biến Text; binding phải khai báo ở đây, nếu không mỗi deploy sẽ xoá DB/R2.
  // Danh mục model của tab Trợ lý chat đọc từ Worker chat-v2 (chỉ GET /models, không cần khoá).
  "vars": {
    "CHAT_V2_URL": "https://zenstudy-chat-v2.leutiendung-hht.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zenspace",
      "database_id": "66bb2a87-05a8-4ea3-bdcb-d8e0d39eb465"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "study-space"
    }
  ],
  // Cùng namespace với Worker chat v2: key `cfg:flags` là nguồn cờ hệ thống và hạn mức.
  "kv_namespaces": [
    {
      "binding": "FLAGS",
      "id": "a16e430f9bbe46afa51ffc9d4f9bce9d"
    }
  ],
  "assets": {
    "directory": "./dist-admin",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}
