{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zenstudy-admin",
  "main": "./admin-worker/_worker.ts",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./dist-admin",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}
