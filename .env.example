# Base URL asset StudySpace (Cloudflare Worker Shield hoặc R2 Custom Domain)
NEXT_PUBLIC_STUDY_CDN_URL=https://study-space-shield.leutiendung-hht.workers.dev

# LiveKit Cloudflare Worker (phát vé + danh sách phòng học nhóm trên production)
# Ví dụ: https://zenstudy-rooms.your-subdomain.workers.dev
NEXT_PUBLIC_LIVEKIT_TOKEN_URL=

# Firebase web (ZenSpace) — 4 mã công khai lấy ở Project settings > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google OAuth Web Client ID cho nút đăng nhập trong web
# Lấy ở Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Dạng: 216513208036-xxx.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Chat proxy Cloudflare Worker (Workers AI + Groq)
# Ví dụ: https://chat-proxy.your-subdomain.workers.dev
NEXT_PUBLIC_CHAT_API_URL=
