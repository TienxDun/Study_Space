# Base URL asset StudySpace (Cloudflare Worker Shield hoặc R2 Custom Domain)
NEXT_PUBLIC_STUDY_CDN_URL=https://study-space-shield.leutiendung-hht.workers.dev

# LiveKit Cloudflare Worker (phát vé + danh sách phòng học nhóm trên production)
# Ví dụ: https://zenstudy-rooms.your-subdomain.workers.dev
NEXT_PUBLIC_LIVEKIT_TOKEN_URL=

# Firebase web (ZenSpace) — 4 mã công khai lấy ở Project settings > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google OAuth Web Client ID cho nút đăng nhập trong web
# Lấy ở Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Dạng: 216513208036-xxx.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Chat proxy Cloudflare Worker (Workers AI + Groq)
# Ví dụ: https://chat-proxy.your-subdomain.workers.dev
NEXT_PUBLIC_CHAT_API_URL=

# Chatbot v2 (Worker riêng ở workers/chat-v2, gọi motapis)
# Local: chạy npm run dev:chat-v2 ở cổng 8788
NEXT_PUBLIC_CHAT_V2_URL=http://localhost:8788
NEXT_PUBLIC_CHAT_V2_DEV_TOKEN=chat-v2-dev-local

# Data API Cloudflare Worker (kho dữ liệu học tập D1: ghi chú, task, phiên tập trung)
# Ví dụ: https://data-api.your-subdomain.workers.dev
NEXT_PUBLIC_DATA_API_URL=

# GoatCounter (thống kê truy cập, không cookie). Nhận mã site của bản hosted
# (ví dụ: zenstudy) hoặc URL đầy đủ của bản tự host (https://stats.example.com).
# Để trống thì không tải script, không đếm gì.
NEXT_PUBLIC_GOATCOUNTER_URL=
